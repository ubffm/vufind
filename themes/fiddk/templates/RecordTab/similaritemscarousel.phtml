<?php $similarRecords = $this->tab->getResults();?>
<?php if (count($similarRecords) != 0) : ?>
    <?php $perPage = 4;
    $recordType = $this->driver->getRecordType();?>
  <div id="similar-items-carousel" class="carousel slide" data-bs-ride="carousel">
    <!-- Indicators -->
    <div class="carousel-indicators">
      <button type="button" data-bs-target="#similar-items-carousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="<?=$this->transEscAttr('Prev')?> 1"></button>
      <?php for ($i = 1; $i < count($similarRecords) / $perPage; $i++) : ?>
        <button type="button" data-bs-target="#similar-items-carousel" data-bs-slide-to="<?=$i ?>" aria-label="<?=$this->transEscAttr('Next')?> <?=$i + 1?>"></button>
      <?php endfor; ?>
    </div>

    <!-- Wrapper for slides -->
    <div class="carousel-inner">
      <div class="carousel-item active">
        <?php foreach ($similarRecords as $index => $data) : ?>
          <div class="carousel-entry <?=$recordType?>Ls">
            <a class="hover-overlay record-cover-link" href="<?=$this->escapeHtmlAttr($this->recordLinker()->getUrl($data))?>">
              <?php $thumb = $this->record($data)->getCoverDetails('similar-items', 'small')['html'];?>
              <?php if (strpos($thumb, "Cover/Unavailable") === false) :?>
                    <?=$thumb?>
              <div class="content">
                <div class="contentDarker">
                    <?=$this->render("RecordTab/innercarousel.phtml", ['data' => $data,'driver' => $this->driver, 'type' => $recordType]);?>
                </div>
              </div>
              <?php else : ?>
            <div class="contentDarker">
                  <?=$this->render("RecordTab/innercarousel.phtml", ['data' => $data,'driver' => $this->driver, 'type' => $recordType]);?>
            </div>
              <?php endif; ?>
            </a>
          </div>
            <?php if (($index + 1) % $perPage == 0 && $index < count($similarRecords) - 1) : ?>
      </div>
      <div class="carousel-item">
            <?php endif; ?>
        <?php endforeach; ?>
      </div>
    </div>

    <!-- Controls -->
    <button class="carousel-control-prev" type="button" data-bs-target="#similar-items-carousel" data-bs-slide="prev" aria-label="<?=$this->transEscAttr('Prev') ?>">
      <span class="fa fa-solid fa-chevron-left glyphicon-chevron-left" title="<?=$this->transEscAttr('Prev') ?>"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#similar-items-carousel" data-bs-slide="next" aria-label="<?=$this->transEscAttr('Next') ?>">
      <span class="fa fa-solid fa-chevron-right glyphicon-chevron-right" title="<?=$this->transEscAttr('Next') ?>"></span>
    </button>
  </div>
<?php else : ?>
  <p><?=$this->transEsc('Cannot find similar records')?></p>
<?php endif; ?>
<?php
  $script = $this->config()->ajaxCoversEnabled() ? "loadCovers();\n" : "";
  $script .= <<<JS
var normalizeHeightCount = $('#similar-items-carousel img').length;
function normalizeHeights() {
  if(--normalizeHeightCount > 0) return;
  var tallest = 0;
  var items = $('#similar-items-carousel .hover-overlay');
  items.each(function() { //add heights to array
    if(tallest < $(this).height()) {
      tallest = $(this).height();
    }
  });
  items.css('min-height', (tallest+25) + 'px');
}
$('#similar-items-carousel img').on('load', normalizeHeights);
JS;
?>
<?=$this->assetManager()->outputInlineScriptString($script) ?>
