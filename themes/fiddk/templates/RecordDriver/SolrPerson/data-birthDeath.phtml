<?php
$birthDates = isset($this->data['dateOfBirth']) && is_array($this->data['dateOfBirth'])
    ? $this->data['dateOfBirth'] : [];
$deathDates = isset($this->data['dateOfDeath']) && is_array($this->data['dateOfDeath'])
    ? $this->data['dateOfDeath'] : [];
$birthPlacesRaw = isset($this->data['placeOfBirth']) && is_array($this->data['placeOfBirth'])
    ? $this->data['placeOfBirth'] : [];
$deathPlacesRaw = isset($this->data['placeOfDeath']) && is_array($this->data['placeOfDeath'])
    ? $this->data['placeOfDeath'] : [];

$birthPlaces = array_column($birthPlacesRaw, 'label');
$deathPlaces = array_column($deathPlacesRaw, 'label');

$hasBirth = !empty($birthDates) || !empty($birthPlaces);
$hasDeath = !empty($deathDates) || !empty($deathPlaces);
?>

<?php if ($hasBirth) : ?>
  <img src="<?=$this->escapeHtmlAttr($this->imageLink('icons/calendar4-event.svg'))?>" alt="Icon" width="16" height="16"></img>&nbsp;<?=$this->transEsc('born')?>
    <?php if (!empty($birthDates)) : ?>
    <span property="birthDate">
        <?=$this->escapeHtml(implode('/', $birthDates))?>
    </span>
    <?php endif; ?>
    <?php if (!empty($birthPlaces)) : ?>
        <?=$this->transEsc('in')?>
    <span property="birthPlace">
        <?=$this->escapeHtml(implode('/', $birthPlaces))?>
    </span>
    <?php endif; ?>
    <?php if ($hasDeath) : ?>
  <br/>
    <?php endif; ?>
<?php endif; ?>

<?php if ($hasDeath) : ?>
  <img src="<?=$this->escapeHtmlAttr($this->imageLink('icons/calendar4-event.svg'))?>" alt="Icon" width="16" height="16"></img>&nbsp;<?=$this->transEsc('died')?>
    <?php if (!empty($deathDates)) : ?>
    <span property="deathDate">
        <?=$this->escapeHtml(implode('/', $deathDates))?>
    </span>
    <?php endif; ?>
    <?php if (!empty($deathPlaces)) : ?>
        <?=$this->transEsc('in')?>
    <span property="deathPlace">
        <?=$this->escapeHtml(implode('/', $deathPlaces))?>
    </span>
    <?php endif; ?>
<?php endif; ?>
