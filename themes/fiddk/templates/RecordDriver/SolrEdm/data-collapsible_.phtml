<?php
$lang = $this->plugin('translate')->getTranslator()->getLocale();

$data  = is_array($data) ? $data : [];
$first = array_slice($data, 0, 5, true);
$rest  = array_slice($data, 5, null, true);
$toggleId = 'toggle_subject_' . substr(md5(json_encode($data)), 0, 8);
?>

<?php foreach ($first as $link => $field) : ?>
    <a href="<?= $this->escapeHtmlAttr($link) ?>" target="_blank">
        <?= $this->escapeHtml($field) ?>
    </a><br/>
<?php endforeach; ?>

<?php if (!empty($rest)) : ?>
    <span class="toggleContainer">
        <input type="checkbox" class="toggle" id="<?= $this->escapeHtmlAttr($toggleId) ?>">

        <span class="toggleContent">
            <?php foreach ($rest as $link => $field) : ?>
                <a href="<?= $this->escapeHtmlAttr($link) ?>" target="_blank">
                    <?= $this->escapeHtml($field) ?>
                </a><br/>
            <?php endforeach; ?>
        </span>

        <label for="<?= $this->escapeHtmlAttr($toggleId) ?>"
               class="<?= $lang === 'de' ? 'label_de' : 'label_en' ?>">
        </label>
    </span>
    <br/>
<?php endif; ?>
