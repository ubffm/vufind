# Basis: offizielles Solr-Image
FROM solr:9

# Setze das Arbeitsverzeichnis
WORKDIR /var/solr

# Optional: eigene ConfigSets oder Core-Configs kopieren
# (falls du z. B. ein Schema, solrconfig.xml etc. hast)
# COPY configsets /opt/solr/server/solr/configsets/myconfig/

# Optional: Plugins oder Module hinzufügen
# COPY plugins /opt/solr/contrib/myplugin/

# Environment-Variablen (können auch in docker-compose.yml bleiben)
ENV SOLR_HOME=/var/solr/data \
    SOLR_JETTY_HOST=0.0.0.0 \
    SOLR_MODULES=analysis-extras

COPY ./plugins/browse-handler.jar /opt/solr/lib/

# Optional: Core automatisch erstellen (nur beim ersten Start)
# Beispiel für einen Core namens "vufind"
# COPY ./init-solr.sh /docker-entrypoint-initdb.d/init-solr.sh

# Exponiere Port (optional, standardmäßig 8983)
EXPOSE 8984

# Standard-Startbefehl
CMD ["solr-foreground"]

